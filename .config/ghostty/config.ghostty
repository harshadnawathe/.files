command = /bin/zsh -l -c 'tmux new-session -A -D -s __'

theme = Tokyonight Night
window-decoration = false

# Fonts
#
# Monaspace, installed via the font-monaspace cask but unused until now.
# Neon is the neo-grotesque of the family, so this is a small step from the
# bundled JetBrains Mono rather than a jarring one.
#
# Radon for italics is a handwriting face. Comments are italic under
# tokyonight, so this is mostly "comments look handwritten". It is the most
# taste-dependent line in this file -- delete it to get upright italics back.
font-family = Monaspace Neon
font-family-italic = Monaspace Radon
# Without this, bold-italic falls back to Neon with a synthetic slant while
# plain italic is real Radon -- verified with `ghostty +show-face --style`.
font-family-bold-italic = Monaspace Radon
font-size = 15

# Ligature sets, read out of the font's own GSUB table rather than guessed:
#
#   ss01 Equal Symbols    ss06 Markdown Strings
#   ss02 Comparisons      ss07 Centered Colon
#   ss03 Arrows           ss08 Centered Period
#   ss04 HTML Tags        ss09 Double Arrows
#   ss05 F# Shapes        ss10 Other Tags
#
# Enabled: the four that fire constantly in Go, Rust, TS, Java and Lua.
# Left off deliberately -- ss04/ss10 (tag shapes), ss05 (|> pipelines, not
# this stack), ss06, and ss07/ss08 which nudge : and . off the baseline.
# Add any of them to this line to try them.
#
# calt is NOT listed: it is Monaspace's texture healing and is already on by
# default. Ghostty's own docs say to pass -calt to turn ligatures off, which
# only makes sense if it is enabled to begin with.
font-feature = ss01, ss02, ss03, ss09

# Text rendering
#
# font-thicken is macOS-only and compensates for Monaspace's lighter stems
# against a dark background.
font-thicken = true
# A little air between lines. Monaspace sets tight default metrics, which
# read as cramped in a full-height tmux pane.
adjust-cell-height = 8%
# Blend in linear space so text over the wallpaper stops picking up the dark
# fringing that native blending produces. `linear-corrected` is the variant
# that keeps weights looking like `native` -- plain `linear` thins dark text
# and fattens light text.
alpha-blending = linear-corrected

background = 000000
background-image = ~/.files/assets/avatar-elements-wallhaven-4xlwel.png
background-image-fit = cover
background-image-opacity = 0.30

macos-option-as-alt = true

# Key bindings

# New pane
keybind = cmd+t=text:\x01c
keybind = cmd+x=text:\x01x

# Split Panes
keybind = cmd+d=text:\x01|
keybind = cmd+shift+d=text:\x01-

# Close window
keybind = cmd+w=text:\x01&

# Pane navigation
keybind = cmd+left=text:\x01h
keybind = cmd+right=text:\x01l
keybind = cmd+up=text:\x01k
keybind = cmd+down=text:\x01j

# Window navigation
keybind = cmd+[=text:\x01p
keybind = cmd+]=text:\x01n
keybind = cmd+\=text:\x01a

keybind = cmd+1=text:\x011
keybind = cmd+2=text:\x012
keybind = cmd+3=text:\x013
keybind = cmd+4=text:\x014
keybind = cmd+5=text:\x015
keybind = cmd+6=text:\x016
keybind = cmd+7=text:\x017
keybind = cmd+8=text:\x018
keybind = cmd+9=text:\x019

# Shift window
keybind = cmd+shift+left=text:\x01<
keybind = cmd+shift+right=text:\x01>

# Session navigation
keybind = cmd+shift+[=text:\x01(
keybind = cmd+shift+]=text:\x01)
keybind = cmd+shift+\=text:\x01S

# Promotion
keybind = cmd+/=text:\x01!
keybind = cmd+shift+/=text:\x01@

# Mark & move (Chords)
keybind = cmd+.>m=text:\x01m
keybind = cmd+.>-=text:\x01t-
keybind = cmd+.>|=text:\x01t|
keybind = cmd+.>@=text:\x01t@
