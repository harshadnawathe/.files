# Select AWS secrets with fzf and print their values. Untested: aws is not
# installed yet. fzf flags are inline because $FZF_CTRL_T_OPTS is the file picker.

# Without this the two calls below fail in turn with the same unhelpful error.
aws sts get-caller-identity >/dev/null || return 1

aws secretsmanager list-secrets \
  | jq --raw-output '.SecretList[].Name' \
  | fzf -m --margin=1 --height=~50% --padding=1 --reverse --border \
        --bind "ctrl-j:down,ctrl-k:up" \
  | while read -r secret_id; do
      aws secretsmanager get-secret-value --secret-id="$secret_id" \
        | jq --raw-output '.SecretString'
    done