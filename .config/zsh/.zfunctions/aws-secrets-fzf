# Ported from functions/aws-secrets-fzf.fish. Multi-select (-m): tab marks
# several secrets and each one's value is fetched in turn.
#
# The sts call is a credential check, not output -- without it the secret list
# fails with an auth error that reads like the secret is missing.
aws-secrets-fzf() {
  aws sts get-caller-identity >/dev/null || return 1

  local secret_id
  aws secretsmanager list-secrets \
    | jq --raw-output '.SecretList[].Name' \
    | fzf -m --margin=1 --padding=1 --border --height=~50% --reverse \
          --bind 'ctrl-j:down,ctrl-k:up' \
    | while read -r secret_id; do
        aws secretsmanager get-secret-value --secret-id="$secret_id" \
          | jq --raw-output '.SecretString'
      done
}
